# Copy to .env for local development. Never commit your real .env to GitHub.
#
# Backend (FastAPI + SQLite default)
DATABASE_URL=sqlite:///./clinicflow.db

# Optional LLM integration
LLM_PROVIDER=nvidia

# You can configure LLM settings generically:
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Or using explicit OpenAI/Nvidia variables (legacy fallback):
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=meta/llama-3.1-8b-instruct

# (Optional) If you add other secrets later, add them here too.
